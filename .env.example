# ─────────────────────────────────────────────────────────────
# Copy thành codebase/.env rồi điền khoá thật. KHÔNG commit .env
# ─────────────────────────────────────────────────────────────

# Stack đang dùng (Python) — dành cho codebase/api/server.py và agent/
MINILAB_PROVIDER=openrouter        # mock | openai | anthropic | openrouter
MINILAB_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
MINILAB_TEMPERATURE=0.2
MINILAB_MAX_TOOL_HOPS=6

# Chạy:  cd codebase && python3 -m api.server --port 8765
# Để test offline không tốn credit: MINILAB_PROVIDER=mock
